digraph FlowWTopics {
    bgcolor="#0b0f19"
    pad="0.5"
    rankdir=LR
    nodesep=0.5
    ranksep=0.8

    node [
        fontname="Arial"
        fontsize=10
        fontcolor="#f3f4f6"
        shape=box
        style="filled,rounded"
        fillcolor="#1e293b"
        color="#475569"
        penwidth=1.5
    ]

    edge [
        fontname="Fira Code, Arial"
        fontsize=9
        fontcolor="#38bdf8"
        color="#6366f1"
        arrowsize=0.8
        penwidth=2
    ]

    // DRIVERS
    subgraph cluster_drivers {
        label="Drivers & Sensors"
        fontname="Arial"
        fontsize=11
        fontcolor="#a5b4fc"
        color="#312e81"
        style=dashed
        
        RealSenseDriver [label="realsense2_camera Node" fillcolor="#1e1b4b" color="#4f46e5"]
        IMUDriver [label="bno055_driver Node" fillcolor="#1e1b4b" color="#4f46e5"]
        EncoderDriver [label="wheel_encoder_driver" fillcolor="#1e1b4b" color="#4f46e5"]
    }

    // PERCEPTION
    subgraph cluster_perception {
        label="Perception Module"
        fontname="Arial"
        fontsize=11
        fontcolor="#6ee7b7"
        color="#064e3b"
        style=dashed

        TerrainNode [label="terrain_geometry_node\n(C++ PCL)" fillcolor="#064e3b" color="#059669"]
        MemoryNode [label="persistent_memory_node\n(Python EMA)" fillcolor="#064e3b" color="#059669"]
        ArucoNode [label="aruco_detector_node\n(OpenCV solvePnP)" fillcolor="#064e3b" color="#059669"]
    }

    // SLAM & STATE ESTIMATION (Option B: EKF + RTAB-Map)
    subgraph cluster_slam_estimation {
        label="SLAM & State Estimation"
        fontname="Arial"
        fontsize=11
        fontcolor="#c084fc"
        color="#581c87"
        style=dashed

        EKFNode [label="robot_localization EKF Node\n(Local Odometry)" fillcolor="#581c87" color="#a855f7"]
        RTABNode [label="rtabmap Node\n(Global SLAM & Loop Closures)" fillcolor="#581c87" color="#a855f7"]
    }

    // NAVIGATION
    subgraph cluster_navigation {
        label="Navigation Stack (Nav2)"
        fontname="Arial"
        fontsize=11
        fontcolor="#fca5a5"
        color="#7f1d1d"
        style=dashed

        CostmapServer [label="nav2_costmap_server" fillcolor="#7f1d1d" color="#ef4444"]
        GlobalPlanner [label="nav2_planner\n(Smac Hybrid A*)" fillcolor="#7f1d1d" color="#ef4444"]
        LocalController [label="nav2_controller\n(MPPI Controller)" fillcolor="#7f1d1d" color="#ef4444"]
    }

    MotorDriver [label="motor_driver Node" fillcolor="#7c2d12" color="#ea580c"]

    // EDGES WITH TOPICS & TRANSFORMS
    RealSenseDriver -> TerrainNode [label=" /camera/depth/color/points\n (sensor_msgs/PointCloud2)"]
    RealSenseDriver -> ArucoNode [label=" /camera/color/image_raw\n (sensor_msgs/Image)"]
    RealSenseDriver -> RTABNode [label=" /camera/depth/image_rect_raw\n (sensor_msgs/Image)"]
    RealSenseDriver -> RTABNode [label=" /camera/color/image_raw\n (sensor_msgs/Image)"]

    TerrainNode -> MemoryNode [label=" /perception/local_bboxes\n (vision_msgs/Detection3DArray)"]
    MemoryNode -> CostmapServer [label=" /perception/obstacles_only\n (vision_msgs/Detection3DArray)"]
    
    ArucoNode -> RTABNode [label=" /perception/aruco_pose\n (geometry_msgs/PoseStamped)"]

    IMUDriver -> EKFNode [label=" /imu/data\n (sensor_msgs/Imu)"]
    EncoderDriver -> EKFNode [label=" /wheel/odom_raw\n (nav_msgs/Odometry)"]

    EKFNode -> RTABNode [label=" /odometry/filtered\n (nav_msgs/Odometry)"]
    EKFNode -> GlobalPlanner [label=" /odometry/filtered\n (nav_msgs/Odometry)"]
    EKFNode -> LocalController [label=" /odometry/filtered\n (nav_msgs/Odometry)"]
    EKFNode -> LocalController [label=" odom->base_link TF\n (TransformStamped)"]

    RTABNode -> CostmapServer [label=" /map\n (nav_msgs/OccupancyGrid)"]
    RTABNode -> GlobalPlanner [label=" map->odom TF\n (TransformStamped)"]

    CostmapServer -> GlobalPlanner [label=" /global_costmap/costmap\n (nav_msgs/OccupancyGrid)"]
    CostmapServer -> LocalController [label=" /local_costmap/costmap\n (nav_msgs/OccupancyGrid)"]

    GlobalPlanner -> LocalController [label=" /plan\n (nav_msgs/Path)"]
    LocalController -> MotorDriver [label=" /cmd_vel\n (geometry_msgs/Twist)"]
}
