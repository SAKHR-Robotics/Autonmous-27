digraph RoverDetailed {
    bgcolor="#0b0f19"
    pad="0.5"
    rankdir=TB
    nodesep=0.4
    ranksep=0.6

    node [
        fontname="Arial"
        fontsize=11
        fontcolor="#f3f4f6"
        shape=box
        style="filled,rounded"
        fillcolor="#1e293b"
        color="#475569"
        penwidth=1.5
    ]

    edge [
        fontname="Arial"
        fontsize=9
        fontcolor="#9ca3af"
        color="#6366f1"
        arrowsize=0.7
        penwidth=1.5
    ]

    // SENSORS
    subgraph cluster_sensors {
        label="Sensing Layer"
        fontname="Arial"
        fontsize=12
        fontcolor="#a5b4fc"
        color="#4338ca"
        style=dashed
        
        RealSense [label="RealSense D4xx\n(RGB-D Stream)" fillcolor="#1e1b4b" color="#4f46e5"]
        IMU [label="BNO055 IMU\n(Orientation & Accel)" fillcolor="#1e1b4b" color="#4f46e5"]
        Encoders [label="Wheel Encoders\n(Ticks)" fillcolor="#1e1b4b" color="#4f46e5"]
    }

    // PERCEPTION
    subgraph cluster_perception {
        label="Perception Module"
        fontname="Arial"
        fontsize=12
        fontcolor="#6ee7b7"
        color="#065f46"
        style=dashed

        P_Filter [label="Depth Filter\n(Voxel Grid)" fillcolor="#064e3b" color="#059669"]
        P_Ransac [label="RANSAC Filter\n(Ground Removal)" fillcolor="#064e3b" color="#059669"]
        P_Dbscan [label="DBSCAN Clustering\n(Object Extractor)" fillcolor="#064e3b" color="#059669"]
        P_Memory [label="Memory Node\n(EMA Rock Database)" fillcolor="#064e3b" color="#059669"]
        P_Aruco [label="ArUco Detector\n(solvePnP Solver)" fillcolor="#064e3b" color="#059669"]
    }

    // SLAM & STATE ESTIMATION (Option B EKF + RTAB-Map)
    subgraph cluster_slam {
        label="SLAM & State Estimation"
        fontname="Arial"
        fontsize=12
        fontcolor="#c084fc"
        color="#6b21a8"
        style=dashed

        S_SlipCheck [label="Heuristic Slip Check\n(Pre-Filter Helper)" fillcolor="#581c87" color="#a855f7"]
        S_EKF [label="robot_localization EKF\n(Local Odometry)" fillcolor="#581c87" color="#a855f7"]
        S_SLAM [label="RTAB-Map SLAM Node\n(Global SLAM & Loop Closures)" fillcolor="#581c87" color="#a855f7"]
    }

    // NAVIGATION
    subgraph cluster_nav {
        label="Navigation Stack (Nav2)"
        fontname="Arial"
        fontsize=12
        fontcolor="#fca5a5"
        color="#991b1b"
        style=dashed

        N_Costmap [label="Costmap Server\n(Global & Local Costmaps)" fillcolor="#7f1d1d" color="#ef4444"]
        N_Global [label="Smac Hybrid A*\n(Global Planner)" fillcolor="#7f1d1d" color="#ef4444"]
        N_Local [label="MPPI Controller\n(Local Path Follower)" fillcolor="#7f1d1d" color="#ef4444"]
    }

    Actuators [label="Actuators & Motors\n(cmd_vel Execution)" fillcolor="#7c2d12" color="#ea580c"]

    // CONNECTIONS
    RealSense -> P_Filter [label=" Point Cloud"]
    RealSense -> P_Aruco [label=" RGB Frame"]
    
    P_Filter -> P_Ransac [label=" Filtered Cloud"]
    P_Ransac -> P_Dbscan [label=" Floating Points"]
    P_Dbscan -> P_Memory [label=" Instanced BBoxes"]
    
    IMU -> S_EKF [label=" Raw IMU & Yaw"]
    Encoders -> S_EKF [label=" Tick Rates"]
    
    IMU -> S_SlipCheck [label=" Turn Checks"]
    Encoders -> S_SlipCheck [label=" Velocity Checks"]
    
    S_SlipCheck -> S_EKF [label=" Covariance Update"]
    P_Aruco -> S_SLAM [label=" /perception/aruco_pose"]
    RealSense -> S_SLAM [label=" RGB + Aligned Depth"]
    
    S_EKF -> S_SLAM [label=" /odometry/filtered"]
    P_Memory -> N_Costmap [label=" /perception/obstacles_only"]
    
    S_SLAM -> N_Costmap [label=" /map"]
    S_SLAM -> N_Global [label=" map->odom TF"]
    S_EKF -> N_Global [label=" /odometry/filtered"]
    S_EKF -> N_Local [label=" odom->base_link TF"]
    
    N_Costmap -> N_Global [label=" Global Costmap"]
    N_Costmap -> N_Local [label=" Local Costmap"]
    
    N_Global -> N_Local [label=" /plan (Waypoints)"]
    N_Local -> Actuators [label=" /cmd_vel"]
}
