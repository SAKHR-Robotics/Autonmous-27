digraph RoverBlackbox {
    bgcolor="#0b0f19"
    pad="0.5"
    rankdir=LR
    nodesep=0.8
    ranksep=1.0

    node [
        fontname="Arial"
        fontsize=10
        fontcolor="#f3f4f6"
        shape=none
    ]

    edge [
        fontname="Arial"
        fontsize=9
        fontcolor="#9ca3af"
        color="#6366f1"
        arrowsize=0.8
        penwidth=2
    ]

    Sensors [label=<
        <table border="0" cellborder="1" cellspacing="0" cellpadding="8" bgcolor="#1e1b4b" color="#4f46e5">
            <tr><td colspan="2" bgcolor="#312e81"><b>SENSING MODULE</b></td></tr>
            <tr>
                <td align="left" valign="top" bgcolor="#111827"><b>Inputs:</b><br/>• Physical environment</td>
                <td align="left" valign="top" bgcolor="#111827"><b>Outputs:</b><br/>• RGB-D stream<br/>• Raw IMU data<br/>• Encoder ticks</td>
            </tr>
        </table>
    >]

    Perception [label=<
        <table border="0" cellborder="1" cellspacing="0" cellpadding="8" bgcolor="#064e3b" color="#059669">
            <tr><td colspan="2" bgcolor="#065f46"><b>PERCEPTION MODULE</b></td></tr>
            <tr>
                <td align="left" valign="top" bgcolor="#111827"><b>Inputs:</b><br/>• RGB-D stream<br/>• Camera Intrinsics</td>
                <td align="left" valign="top" bgcolor="#111827"><b>Outputs:</b><br/>• 3D Bounding Boxes<br/>• ArUco marker poses</td>
            </tr>
        </table>
    >]

    SLAM [label=<
        <table border="0" cellborder="1" cellspacing="0" cellpadding="8" bgcolor="#581c87" color="#a855f7">
            <tr><td colspan="2" bgcolor="#6b21a8"><b>SLAM &amp; FUSION MODULE</b></td></tr>
            <tr>
                <td align="left" valign="top" bgcolor="#111827"><b>Inputs:</b><br/>• Wheel ticks &amp; IMU data<br/>• ArUco poses<br/>• 3D Bounding Boxes</td>
                <td align="left" valign="top" bgcolor="#111827"><b>Outputs:</b><br/>• Fused Odometry<br/>• 2D Occupancy Grid Map<br/>• map &rarr; odom TF</td>
            </tr>
        </table>
    >]

    Navigation [label=<
        <table border="0" cellborder="1" cellspacing="0" cellpadding="8" bgcolor="#7f1d1d" color="#ef4444">
            <tr><td colspan="2" bgcolor="#991b1b"><b>NAVIGATION &amp; PLANNING</b></td></tr>
            <tr>
                <td align="left" valign="top" bgcolor="#111827"><b>Inputs:</b><br/>• Fused Odometry &amp; Map<br/>• Target coordinate goal</td>
                <td align="left" valign="top" bgcolor="#111827"><b>Outputs:</b><br/>• Drive Command (cmd_vel)</td>
            </tr>
        </table>
    >]

    Actuation [label=<
        <table border="0" cellborder="1" cellspacing="0" cellpadding="8" bgcolor="#7c2d12" color="#ea580c">
            <tr><td colspan="2" bgcolor="#9a3412"><b>ACTUATION MODULE</b></td></tr>
            <tr>
                <td align="left" valign="top" bgcolor="#111827"><b>Inputs:</b><br/>• Drive Command (cmd_vel)</td>
                <td align="left" valign="top" bgcolor="#111827"><b>Outputs:</b><br/>• Motor RPMs / voltages<br/>• Physical movement</td>
            </tr>
        </table>
    >]

    // Connections between modules showing the flow
    Sensors -> Perception [label=" Camera feed"]
    Sensors -> SLAM [label=" IMU / Encoders"]
    Perception -> SLAM [label=" Obstacles / Markers"]
    SLAM -> Navigation [label=" Odom / Map"]
    Navigation -> Actuation [label=" cmd_vel"]
}
